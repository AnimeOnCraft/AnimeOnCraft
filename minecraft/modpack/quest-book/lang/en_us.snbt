{
  "chapter.1000000000000001.title": "Начало приключения",
  "quest.2000000000000001.title": "Запас древесины",
  "quest.2000000000000001.quest_desc": [
    "Собери 16 дубовых брёвен. Для быстрой рубки дерева присядь с топором. На чужой территории рубка запрещена."
  ],
  "quest.2000000000000002.title": "Своя мастерская",
  "quest.2000000000000002.quest_desc": [
    "Сделай верстак. Место для базы выбирай на территории своего клана."
  ],
  "quest.2000000000000003.title": "Первая плавка",
  "quest.2000000000000003.quest_desc": [
    "Сделай печь для первых руд и еды."
  ],
  "quest.2000000000000004.title": "Железный инструмент",
  "quest.2000000000000004.quest_desc": [
    "Подготовь железную кирку. Предметы для заданий остаются у тебя."
  ],
  "chapter.1000000000000002.title": "Магия",
  "quest.2000000000000005.title": "Основы знаний",
  "quest.2000000000000005.quest_desc": [
    "Сделай книгу. Изучай рецепты магических предметов в EMI."
  ],
  "quest.2000000000000006.title": "Магическая эссенция",
  "quest.2000000000000006.quest_desc": [
    "Собери эссенцию для магических рецептов. JER показывает доступную информацию о добыче."
  ],
  "quest.2000000000000007.title": "Первые чернила",
  "quest.2000000000000007.quest_desc": [
    "Найди или создай обычные чернила для свитков."
  ],
  "quest.2000000000000008.title": "Место для заклинаний",
  "quest.2000000000000008.quest_desc": [
    "Подготовь магическую наковальню. Союзники твоего клана защищены от дружественного урона."
  ],
  "chapter.1000000000000003.title": "Механизмы Create",
  "quest.2000000000000009.title": "Андезитовый сплав",
  "quest.2000000000000009.quest_desc": [
    "Создай материал для первых механизмов."
  ],
  "quest.200000000000000A.title": "Передача вращения",
  "quest.200000000000000A.quest_desc": [
    "Сделай валы. Механизмы не должны пересекать чужие защищённые территории."
  ],
  "quest.200000000000000B.title": "Шестерни",
  "quest.200000000000000B.quest_desc": [
    "Подготовь шестерни и изучи подсказки Ponder для механизмов."
  ],
  "quest.200000000000000C.title": "Энергия воды",
  "quest.200000000000000C.quest_desc": [
    "Установи водяное колесо как первый источник вращения."
  ],
  "quest.200000000000000D.title": "Механический пресс",
  "quest.200000000000000D.quest_desc": [
    "Построй пресс. Расход материалов проверяй по текущим рецептам EMI."
  ],
  "chapter.1000000000000004.title": "Исследование мира",
  "quest.200000000000000E.title": "Дальняя дорога",
  "quest.200000000000000E.quest_desc": [
    "Подготовь лук и припасы перед вылазкой."
  ],
  "quest.200000000000000F.title": "Ориентир",
  "quest.200000000000000F.quest_desc": [
    "Сделай компас. Для карты мира и территорий кланов используй Xaero World Map (M). Цветные границы и подсказки показывают владельца территории."
  ],
  "quest.2000000000000010.title": "Наблюдатель",
  "quest.2000000000000010.quest_desc": [
    "Сделай подзорную трубу для разведки. Новые поселения Towns and Towers ищи в новых чанках."
  ],
  "quest.2000000000000011.title": "Жемчужина странника",
  "quest.2000000000000011.quest_desc": [
    "Добудь жемчуг Края. Прежде чем бросать его, учитывай правила территорий."
  ],
  "chapter.1000000000000005.title": "Сумеречный лес",
  "quest.2000000000000012.title": "Открыть Сумеречный лес",
  "quest.2000000000000012.quest_desc": [
    "Сделай бассейн воды 2×2, окружи его подходящими цветами или растениями и брось алмаз. Проверяй прогрессию измерения по достижениям; эта отметка лишь памятка о портале."
  ],
  "quest.2000000000000013.title": "Победить Нагу",
  "quest.2000000000000013.quest_desc": [
    "Найди лабиринт Наги и получи чешую. Это первый шаг местной последовательности боссов."
  ],
  "quest.2000000000000014.title": "Башня Лича",
  "quest.2000000000000014.quest_desc": [
    "После Наги исследуй башню Лича. Читай достижения: они подсказывают порядок прохождения."
  ],
  "quest.2000000000000015.title": "Огненный металл",
  "quest.2000000000000015.quest_desc": [
    "Продолжай прохождение Сумеречного леса и собери огненные слитки."
  ],
  "quest.2000000000000016.title": "Рыцарский металл",
  "quest.2000000000000016.quest_desc": [
    "Исследуй подземные крепости и получи рыцарский металл."
  ]
}

{
  "name": "animeoncraft",
  "version": "0.8.11-sora-guild",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare:launcher:bootstrap": "node scripts/prepare-launcher-bootstrap.mjs",
    "test:client:downloads": "node --test scripts/test-managed-client-download.mjs",
    "test:client:preparation": "node scripts/test-launcher-client-preparation.mjs",
    "test:client:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-client-preparation.ps1",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "check": "corepack pnpm build && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "dev:backend": "corepack pnpm --filter @animeoncraft/backend dev",
    "dev:admin": "corepack pnpm --filter @animeoncraft/admin dev",
    "dev:admin:https": "node scripts/serve-admin.mjs",
    "dev:launcher": "corepack pnpm --filter @animeoncraft/launcher dev",
    "build:native": "corepack pnpm --filter @animeoncraft/launcher tauri:build",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher-installer.ps1",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-launcher-installer.ps1",
    "test:self-update": "node scripts/test-launcher-self-update.mjs",
    "test:installed-update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installed-update.ps1",
    "test:simple-update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-simple-update.ps1",
    "prepare:update": "node scripts/prepare-launcher-update.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-friends-preview.ps1",
    "test:native-account": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-friends.ps1",
    "test:launcher-dev": "node scripts/launcher-dev-smoke.mjs",
    "test:storage": "node scripts/storage-smoke.mjs",
    "build:java": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/java-check.ps1",
    "contracts:check": "corepack pnpm --filter @animeoncraft/contracts test",
    "check:modpack": "node scripts/check-modpack.mjs",
    "prepare:minecraft:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-local-game.ps1",
    "prepare:modpack": "node scripts/prepare-modpack.mjs",
    "prepare:modpack:client": "node scripts/prepare-minecraft-client.mjs",
    "dev:minecraft:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-modpack-server.ps1",
    "dev:minecraft:demo": "node scripts/start-modpack-client-demo.mjs",
    "test:minecraft:local": "node scripts/test-local-game-runtime.mjs",
    "test:minecraft:server": "node scripts/test-modpack-server.mjs",
    "test:minecraft:join": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-game.ps1",
    "build:minecraft:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-minecraft-integration.ps1",
    "test:minecraft:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-game.ps1",
    "test:minecraft:admission": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-game-admission.ps1",
    "db:generate": "corepack pnpm --filter @animeoncraft/backend db:generate",
    "db:migrate": "corepack pnpm --filter @animeoncraft/backend db:migrate",
    "db:seed": "corepack pnpm --filter @animeoncraft/backend db:seed",
    "db:smoke": "corepack pnpm --filter @animeoncraft/backend db:smoke",
    "test:database": "corepack pnpm --filter @animeoncraft/backend test:database",
    "test:auth": "corepack pnpm --filter @animeoncraft/backend test:auth",
    "test:clans": "corepack pnpm --filter @animeoncraft/backend test:clans",
    "test:mail": "corepack pnpm --filter @animeoncraft/backend test:mail",
    "test:auth-runtime": "node scripts/auth-runtime-smoke.mjs",
    "test:admin-https": "node scripts/admin-https-smoke.mjs",
    "dev:backend:auth": "node scripts/dev-backend-auth.mjs",
    "test:pack": "cargo test --locked --manifest-path apps/launcher/src-tauri/Cargo.toml pack::tests",
    "audit:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-native.ps1",
    "test:ntfs": "cargo test --locked --manifest-path apps/launcher/src-tauri/Cargo.toml pack::ntfs -- --test-threads=1",
    "test:tuf-store": "cargo test --locked --manifest-path apps/launcher/src-tauri/Cargo.toml pack::ntfs::bridge -- --test-threads=1",
    "test:download": "cargo test --locked --manifest-path apps/launcher/src-tauri/Cargo.toml pack::ntfs::download -- --test-threads=1",
    "test:install": "cargo test --locked --manifest-path apps/launcher/src-tauri/Cargo.toml pack::ntfs::install -- --test-threads=1",
    "backup:server": "node scripts/backup-friends-server.mjs",
    "test:backup": "node scripts/test-friends-backup.mjs",
    "beta:status": "corepack pnpm --filter @animeoncraft/backend exec tsx db/beta-campaign.ts status",
    "beta:preflight": "node scripts/beta-preflight.mjs",
    "build:friends-client": "node scripts/build-friends-client-kit.mjs",
    "test:friends-api": "node scripts/test-friends-api-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.0.3",
    "globals": "17.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}

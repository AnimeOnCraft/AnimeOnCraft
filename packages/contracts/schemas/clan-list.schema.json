{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeoncraft.local/schemas/clan-list.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clan"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "clan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "short_code",
        "description",
        "logo_url",
        "discord_url",
        "member_count",
        "online_count",
        "online_updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "short_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "discord_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]{6}$"
        },
        "member_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "online_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "online_updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeoncraft.invalid/schemas/pack-manifest-v1.json",
  "title": "AnimeOnCraft pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "channel",
    "release_sequence",
    "platform",
    "minecraft_version",
    "loader",
    "java",
    "minimum_launcher_version",
    "integration_protocol_major",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "channel": {
      "enum": [
        "stable",
        "staging"
      ]
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709552000
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "const": "windows"
        },
        "arch": {
          "const": "x86_64"
        }
      }
    },
    "minecraft_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "vanilla",
            "fabric",
            "forge",
            "neoforge"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "distribution_ref"
      ],
      "properties": {
        "major": {
          "enum": [
            17,
            21
          ]
        },
        "distribution_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "minimum_launcher_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "integration_protocol_major": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "length",
          "side",
          "source_ref",
          "managed"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(mods|libraries|assets/objects|versions|natives)/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 21474836480
          },
          "side": {
            "enum": [
              "CLIENT",
              "SERVER",
              "BOTH"
            ]
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "object_key"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "object_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9._/-]+$"
              }
            }
          },
          "managed": {
            "const": true
          }
        }
      }
    }
  }
}

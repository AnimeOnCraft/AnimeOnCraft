# Fill after choosing the host/domain. Keep the resulting .env private.
NODE_ENV=production
AOC_FRIENDS_DEPLOYMENT=true
AOC_AUTH_ENABLED=true
AOC_LOCAL_BASE_API=false
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=3000
INTEGRATION_HOST=127.0.0.1
INTEGRATION_PORT=3001
AOC_AUTH_ORIGIN=https://api.example.invalid
AOC_PUBLIC_DOMAIN=api.example.invalid
AOC_AUTH_MAIL_MODE=disabled
AOC_AUTH_RATE_NAMESPACE=aoc:friends
AOC_MFA_KEY_ID=friends-v1
AOC_MFA_KEY=REPLACE_WITH_64_HEX
AOC_AUTH_PRIVACY_KEY=REPLACE_WITH_64_HEX
AOC_CSRF_KEY=REPLACE_WITH_64_HEX
AOC_CURSOR_SECRET=REPLACE_WITH_64_HEX
AOC_GAME_SERVER_ID=REPLACE_WITH_REGISTERED_SERVER_UUID
AOC_GAME_SERVER_KEY=REPLACE_WITH_64_HEX
DATABASE_URL=postgresql://anime_app:REPLACE_PASSWORD@127.0.0.1:54329/animeoncraft?schema=public
MIGRATION_DATABASE_URL=postgresql://anime_migrator:REPLACE_PASSWORD@127.0.0.1:54329/animeoncraft?schema=public
VALKEY_URL=redis://default:REPLACE_PASSWORD@127.0.0.1:56379/0
AOC_DEV_MIGRATION_DB_PASSWORD=REPLACE_PASSWORD
AOC_DEV_APP_DB_PASSWORD=REPLACE_PASSWORD
AOC_DEV_VALKEY_PASSWORD=REPLACE_PASSWORD

[Unit]
Description=AnimeOnCraft scheduled verified backup and maintenance
After=docker.service animeoncraft-api.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/animeoncraft
UMask=0077
ExecStart=/usr/bin/flock -n /run/lock/animeoncraft-backup.lock /usr/bin/node scripts/scheduled-friends-backup.mjs
TimeoutStartSec=45min


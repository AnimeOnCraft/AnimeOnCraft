// SQL migrations own CHECK/partial indexes/triggers; relation arrays include historical rows.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login                                                 String                     @default(dbgenerated("('legacy_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(64)
  loginKey                                              String                     @unique @default(dbgenerated()) @map("login_key") @db.VarChar(64)
  passwordChangeRequired                                Boolean                    @default(false) @map("password_change_required")
  email                                                 String                     @db.VarChar(320)
  emailKey                                              String                     @unique @map("email_key") @db.VarChar(320)
  emailVerifiedAt                                       DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  passwordHash                                          String                     @map("password_hash")
  systemRole                                            SystemRole                 @default(PLAYER) @map("system_role")
  state                                                 UserState                  @default(ACTIVE)
  authEpoch                                             BigInt                     @default(0) @map("auth_epoch")
  accessEpoch                                           BigInt                     @default(0) @map("access_epoch")
  version                                               BigInt                     @default(0)
  createdAt                                             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                             DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  application_history                                   application_history[]
  audit_logs                                            audit_logs[]
  bans_bans_issued_byTousers                            bans[]                     @relation("bans_issued_byTousers")
  bans_bans_user_idTousers                              bans[]                     @relation("bans_user_idTousers")
  clan_applications_clan_applications_decided_byTousers clan_applications[]        @relation("clan_applications_decided_byTousers")
  clan_applications_clan_applications_user_idTousers    clan_applications[]        @relation("clan_applications_user_idTousers")
  clan_manager_assignments                              clan_manager_assignments[]
  clan_members                                          clan_members[]
  minecraft_accounts                                    minecraft_accounts[]
  game_profile                                          game_profiles?
  skin                                                  player_skins?
  capes                                                 player_capes[]
  back_equipment                                        player_back_equipment?
  emote_grants                                          player_emote_grants[]
  game_tickets                                          game_tickets[]
  news                                                  news[]
  player_statistics                                     player_statistics[]
  sessions                                              sessions[]
  auth_challenges                                       auth_challenges[]
  mfa_credentials                                       mfa_credentials?
  mfa_recovery_codes                                    mfa_recovery_codes[]
  outbox_events                                         outbox_events[]
  idempotency_keys                                      idempotency_keys[]
  whitelist_whitelist_granted_byTousers                 whitelist[]                @relation("whitelist_granted_byTousers")
  whitelist_whitelist_user_idTousers                    whitelist[]                @relation("whitelist_user_idTousers")


  clan_online_presence                                  clan_online_presence[]
  @@map("users")
}

model game_profiles {
  user_id        String   @id @db.Uuid
  game_name      String   @db.VarChar(16)
  game_name_key  String   @unique @default(dbgenerated()) @db.VarChar(16)
  minecraft_uuid String   @unique @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model player_skins {
  user_id    String @id @db.Uuid
  png        Bytes @db.ByteA
  model      String @db.VarChar(7)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  user       User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model game_tickets {
  token_hash   String    @id @db.Char(64)
  user_id      String    @db.Uuid
  session_id   String    @db.Uuid
  server_id    String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  expires_at   DateTime  @db.Timestamptz(3)
  consumed_at  DateTime? @db.Timestamptz(3)
  revoked_at   DateTime? @db.Timestamptz(3)
  connection_id String? @db.Uuid
  joined_at     DateTime? @db.Timestamptz(3)
  launcher_version String?
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  session      sessions     @relation(fields: [session_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  server       game_servers @relation(fields: [server_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id, server_id], map: "game_tickets_user_server")
}

model beta_campaign {
  id String @id @db.VarChar(16)
  starts_at DateTime? @db.Timestamptz(3)
  ends_at DateTime? @db.Timestamptz(3)
}

model player_emote_grants {
  user_id String @db.Uuid
  code String @db.VarChar(32)
  source String @db.VarChar(80)
  granted_at DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@id([user_id, code])
}

model player_back_equipment {
  user_id String @id @db.Uuid
  kind String @default("NONE") @db.VarChar(8)
  code String @default("") @db.VarChar(32)
  revision BigInt @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model player_capes {
  user_id String @db.Uuid
  cape_id String @db.VarChar(32)
  awarded_at DateTime @default(now()) @db.Timestamptz(3)
  equipped Boolean @default(false)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@id([user_id, cape_id])
}

model Clan {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String                     @db.VarChar(64)
  shortCode                String                     @map("short_code") @db.VarChar(12)
  codeKey                  String                     @unique @map("code_key") @db.VarChar(12)
  description              String                     @default("") @db.VarChar(4000)
  logoUrl                  String?                    @map("logo_url")
  discordUrl               String?                    @map("discord_url")
  enabled                  Boolean                    @default(false)
  archivedAt               DateTime?                  @map("archived_at") @db.Timestamptz(3)
  version                  BigInt                     @default(0)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  logo_media_id            String?                    @db.Uuid
  color                    String?                    @db.Char(6)
  clan_applications        clan_applications[]
  clan_manager_assignments clan_manager_assignments[]
  clan_members             clan_members[]
  clan_roles               clan_roles[]
  media_assets             media_assets?              @relation(fields: [logo_media_id], references: [id], onDelete: Restrict, onUpdate: NoAction)


  clan_achievements                                                          clan_achievements[]
  clan_event_scores                                                          clan_event_scores[]
  clan_gameplay_events                                                       clan_gameplay_events[]
  clan_online_presence                                                       clan_online_presence[]
  clan_progression                                                           clan_progression?
  clan_territory_control_clan_territory_control_captured_from_clan_idToclans clan_territory_control[]   @relation("clan_territory_control_captured_from_clan_idToclans")
  clan_territory_control_clan_territory_control_controller_clan_idToclans    clan_territory_control[]   @relation("clan_territory_control_controller_clan_idToclans")
  clan_war_windows_clan_war_windows_attacker_clan_idToclans                  clan_war_windows[]         @relation("clan_war_windows_attacker_clan_idToclans")
  clan_war_windows_clan_war_windows_defender_clan_idToclans                  clan_war_windows[]         @relation("clan_war_windows_defender_clan_idToclans")
  @@map("clans")
}

model application_history {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id    String             @db.Uuid
  status            application_status
  actor_user_id     String?            @db.Uuid
  reason            String?            @db.VarChar(1000)
  time              DateTime           @default(now()) @db.Timestamptz(3)
  users             User?              @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  clan_applications clan_applications  @relation(fields: [application_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id    String?             @db.Uuid
  actor_service_id String?             @db.Uuid
  service_identity service_principals? @relation(fields: [actor_service_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "audit_logs_service_fkey")
  actor_kind       audit_actor_kind
  action           String              @db.VarChar(64)
  target_type      String              @db.VarChar(64)
  target_id        String              @db.Uuid
  before_redacted  Json?
  after_redacted   Json?
  reason           String              @db.VarChar(1000)
  request_id       String              @db.Uuid
  time             DateTime            @default(now()) @db.Timestamptz(3)
  users            User?               @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actor_user_id, time], map: "audit_logs_actor_time")
  @@index([target_type, target_id, time], map: "audit_logs_target_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bans {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     String    @db.Uuid
  scope                       ban_scope
  reason_private              String    @db.VarChar(1000)
  message_public              String    @db.VarChar(1000)
  issued_by                   String    @db.Uuid
  created_at                  DateTime  @default(now()) @db.Timestamptz(3)
  expires_at                  DateTime? @db.Timestamptz(3)
  revoked_at                  DateTime? @db.Timestamptz(3)
  version                     BigInt    @default(0)
  users_bans_issued_byTousers User      @relation("bans_issued_byTousers", fields: [issued_by], references: [id], onUpdate: NoAction)
  users_bans_user_idTousers   User      @relation("bans_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id, revoked_at, expires_at], map: "bans_policy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clan_applications {
  id                                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                   String                @db.Uuid
  clan_id                                   String                @db.Uuid
  message                                   String                @db.VarChar(4000)
  status                                    application_status    @default(PENDING)
  decided_by                                String?               @db.Uuid
  decided_at                                DateTime?             @db.Timestamptz(3)
  reason                                    String?               @db.VarChar(1000)
  version                                   BigInt                @default(0)
  created_at                                DateTime              @default(now()) @db.Timestamptz(3)
  application_history                       application_history[]
  clans                                     Clan                  @relation(fields: [clan_id], references: [id], onUpdate: NoAction)
  users_clan_applications_decided_byTousers User?                 @relation("clan_applications_decided_byTousers", fields: [decided_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_clan_applications_user_idTousers    User                  @relation("clan_applications_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)
  clan_members                              clan_members[]

  @@unique([id, user_id, clan_id])
  @@index([clan_id, status, created_at, id], map: "clan_applications_queue")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clan_manager_assignments {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @db.Uuid
  clan_id    String     @db.Uuid
  role_id    String     @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(3)
  ended_at   DateTime?  @db.Timestamptz(3)
  version    BigInt     @default(0)
  can_remove_members Boolean @default(false)
  clans      Clan       @relation(fields: [clan_id], references: [id], onUpdate: NoAction)
  clan_roles clan_roles @relation(fields: [role_id, clan_id], references: [id, clan_id], onUpdate: NoAction)
  users      User       @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model idempotency_keys {
  principal_id String @db.Uuid
  route String @db.VarChar(256)
  key String @db.Uuid
  request_digest String @db.Char(64)
  result Json
  created_at DateTime @default(now()) @db.Timestamptz(3)
  expires_at DateTime @db.Timestamptz(3)
  user User @relation(fields: [principal_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([principal_id, route, key])
  @@index([expires_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clan_members {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clan_id                 String             @db.Uuid
  user_id                 String             @db.Uuid
  joined_at               DateTime           @default(now()) @db.Timestamptz(3)

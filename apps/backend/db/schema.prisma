  kind auth_token_kind
  created_at DateTime @default(now()) @db.Timestamptz(3)
  expires_at DateTime @db.Timestamptz(3)
  used_at DateTime? @db.Timestamptz(3)
  revoked_at DateTime? @db.Timestamptz(3)
  session sessions @relation(fields: [session_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([session_id,revoked_at], map: "auth_tokens_session")
}

model auth_challenges {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  session_id String? @db.Uuid
  kind auth_challenge_kind
  token_hash String @unique @db.Char(64)
  auth_epoch BigInt
  client_kind session_client_kind?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  expires_at DateTime @db.Timestamptz(3)
  consumed_at DateTime? @db.Timestamptz(3)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  session sessions? @relation(fields: [session_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([user_id,kind,consumed_at], map: "auth_challenges_user")
}

model mfa_credentials {
  user_id String @id @db.Uuid
  secret_ciphertext String
  key_id String @db.VarChar(64)
  enabled Boolean @default(false)
  pending_expires_at DateTime? @db.Timestamptz(3)
  last_used_step BigInt @default(-1)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model mfa_recovery_codes {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  code_hash String @unique @db.Char(64)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  used_at DateTime? @db.Timestamptz(3)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([user_id,used_at], map: "mfa_recovery_codes_user")
}

model clan_achievements {
  clan_id     String    @db.Uuid
  code        String    @db.VarChar(64)
  progress    BigInt    @default(0)
  target      BigInt
  unlocked_at DateTime? @db.Timestamptz(3)
  version     BigInt    @default(0)
  updated_at  DateTime  @default(now()) @db.Timestamptz(3)
  clans       Clan      @relation(fields: [clan_id], references: [id], onUpdate: NoAction)

  @@id([clan_id, code])
}

model clan_event_scores {
  event_id          String      @db.Uuid
  clan_id           String      @db.Uuid
  score             BigInt      @default(0)
  reward_granted_at DateTime?   @db.Timestamptz(3)
  version           BigInt      @default(0)
  updated_at        DateTime    @default(now()) @db.Timestamptz(3)
  clans             Clan        @relation(fields: [clan_id], references: [id], onUpdate: NoAction)
  clan_events       clan_events @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, clan_id])
}

model clan_events {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String              @unique(map: "clan_events_code") @db.VarChar(64)
  title             String              @db.VarChar(160)
  status            String              @db.VarChar(16)
  starts_at         DateTime            @db.Timestamptz(3)
  ends_at           DateTime            @db.Timestamptz(3)
  payload           Json                @default("{}")
  version           BigInt              @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  clan_event_scores clan_event_scores[]
}

model clan_gameplay_events {
  event_id         String       @id @db.Uuid
  server_id        String       @db.Uuid
  clan_id          String       @db.Uuid
  kind             String       @db.VarChar(64)
  xp_delta         BigInt       @default(0)
  reputation_delta Int          @default(0)
  payload          Json         @default("{}")
  occurred_at      DateTime     @db.Timestamptz(3)
  created_at       DateTime     @default(now()) @db.Timestamptz(3)
  clans            Clan         @relation(fields: [clan_id], references: [id], onUpdate: NoAction)
  game_servers     game_servers @relation(fields: [server_id], references: [id], onUpdate: NoAction)

  @@index([clan_id, occurred_at(sort: Desc)], map: "clan_gameplay_events_clan_time")
}

model clan_online_presence {
  server_id    String       @db.Uuid
  user_id      String       @db.Uuid
  clan_id      String?      @db.Uuid
  online       Boolean      @default(false)
  last_seen_at DateTime     @default(now()) @db.Timestamptz(3)
  updated_at   DateTime     @default(now()) @db.Timestamptz(3)
  clans        Clan?        @relation(fields: [clan_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  game_servers game_servers @relation(fields: [server_id], references: [id], onUpdate: NoAction)
  users        User         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@id([server_id, user_id])
  @@index([clan_id, online, last_seen_at], map: "clan_online_presence_clan")
}

model clan_progression {
  clan_id    String   @id @db.Uuid
  xp         BigInt   @default(0)
  level      Int      @default(1)
  reputation Int      @default(0)
  statistics Json     @default("{}")
  version    BigInt   @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  clans      Clan     @relation(fields: [clan_id], references: [id], onUpdate: NoAction)
}

model clan_territory_control {
  territory_code                                            String           @id @db.VarChar(12)
  controller_clan_id                                        String           @db.Uuid
  captured_from_clan_id                                     String           @db.Uuid
  war_window_id                                             String           @db.Uuid
  captured_at                                               DateTime         @default(now()) @db.Timestamptz(3)
  version                                                   BigInt           @default(0)
  clans_clan_territory_control_captured_from_clan_idToclans Clan             @relation("clan_territory_control_captured_from_clan_idToclans", fields: [captured_from_clan_id], references: [id], onUpdate: NoAction)
  clans_clan_territory_control_controller_clan_idToclans    Clan             @relation("clan_territory_control_controller_clan_idToclans", fields: [controller_clan_id], references: [id], onUpdate: NoAction)
  clan_war_windows                                          clan_war_windows @relation(fields: [war_window_id], references: [id], onUpdate: NoAction)
}

model clan_war_windows {
  id                                             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attacker_clan_id                               String                   @db.Uuid
  defender_clan_id                               String                   @db.Uuid
  status                                         String                   @db.VarChar(16)
  preparation_starts_at                          DateTime                 @db.Timestamptz(3)
  active_starts_at                               DateTime                 @db.Timestamptz(3)
  active_ends_at                                 DateTime                 @db.Timestamptz(3)
  cooldown_ends_at                               DateTime?                @db.Timestamptz(3)
  reason                                         String                   @db.VarChar(1000)
  version                                        BigInt                   @default(0)
  created_at                                     DateTime                 @default(now()) @db.Timestamptz(3)
  clan_territory_control                         clan_territory_control[]
  clans_clan_war_windows_attacker_clan_idToclans Clan                     @relation("clan_war_windows_attacker_clan_idToclans", fields: [attacker_clan_id], references: [id], onUpdate: NoAction)
  clans_clan_war_windows_defender_clan_idToclans Clan                     @relation("clan_war_windows_defender_clan_idToclans", fields: [defender_clan_id], references: [id], onUpdate: NoAction)

  @@index([active_starts_at, active_ends_at, status], map: "clan_war_windows_active")
}

enum auth_token_kind {
  ACCESS
  REFRESH
}

enum auth_challenge_kind {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_MFA
  MINECRAFT_BIND
}

enum SystemRole {
  OWNER
  PLAYER

  @@map("system_role")
}

enum UserState {
  ACTIVE
  SUSPENDED

  @@map("user_state")
}

enum application_status {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum audit_actor_kind {
  USER
  SERVICE
  OPERATOR
  DEVELOPMENT
}

enum ban_scope {
  GAME
  ACCOUNT
}

enum minecraft_account_state {
  VERIFIED
  REVOKED
}

enum session_client_kind {
  LAUNCHER
  WEB_ADMIN
}

enum whitelist_kind {
  MEMBERSHIP
  OWNER
}

model clan_server_presence {
  server_id String @id @db.Uuid
  snapshot_at DateTime @db.Timestamptz(3)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  server game_servers @relation(fields:[server_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
}

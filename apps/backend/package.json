{
  "name": "@animeoncraft/backend",
  "version": "0.7.20-friends-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "corepack pnpm db:generate && tsc -p tsconfig.build.json",
    "typecheck": "corepack pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm db:generate && vitest run",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:smoke": "tsx db/smoke.ts",
    "test:gameplay": "tsx db/gameplay-smoke.ts",
    "test:gameplay:integration": "tsx db/gameplay-integration.ts",
    "test:database": "tsx db/domain-smoke.ts",
    "test:auth": "tsx db/friends-smoke.ts",
    "test:clans": "tsx db/clan-smoke.ts",
    "test:mail": "tsx db/mail-smoke.ts",
    "world:import": "tsx db/world-import.ts",
    "world:relief": "tsx db/world-relief.ts"
  },
  "dependencies": {
    "@animeoncraft/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.6",
    "fastify": "5.12.5",
    "ioredis": "5.8.2",
    "nodemailer": "10.1.0",
    "otpauth": "9.5.2",
    "pngjs": "7.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "smol-toml": "1.3.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

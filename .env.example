# Development only. Prefer scripts/dev-env.ps1 to generate the ignored .env.
AOC_DEV_APP_DB_PASSWORD=CHANGE_ME_APP
AOC_DEV_MIGRATION_DB_PASSWORD=CHANGE_ME_MIGRATOR
AOC_DEV_VALKEY_PASSWORD=CHANGE_ME_VALKEY
AOC_CURSOR_SECRET=GENERATE_48_HEX_CHARACTERS
AOC_LOCAL_BASE_API=false
AOC_AUTH_ENABLED=false
AOC_MFA_KEY=GENERATE_64_HEX_CHARACTERS
AOC_MFA_KEY_ID=development-v1
AOC_AUTH_PRIVACY_KEY=GENERATE_64_HEX_CHARACTERS
AOC_CSRF_KEY=GENERATE_64_HEX_CHARACTERS
AOC_AUTH_ORIGIN=https://localhost

# Optional friends game admission. Leave unset until the server adapter is installed.
# AOC_GAME_SERVER_ID=EXISTING_GAME_SERVERS_UUID
# AOC_GAME_SERVER_KEY=GENERATE_PRIVATE_64_LOWERCASE_HEX_CHARACTERS
# Server-side only: never put this key in a launcher build, modpack or updater files.

# Friends accounts do not require SMTP or email verification.
# Password recovery is performed manually by OWNER to the stored contact address.
AOC_MINECRAFT_BINDING_APPROVED=false
# AOC_MICROSOFT_CLIENT_ID=OWN_REGISTERED_PUBLIC_CLIENT_ID
DATABASE_URL=postgresql://anime_app:CHANGE_ME_APP@127.0.0.1:54329/animeoncraft?schema=public
MIGRATION_DATABASE_URL=postgresql://anime_migrator:CHANGE_ME_MIGRATOR@127.0.0.1:54329/animeoncraft?schema=public
VALKEY_URL=redis://default:CHANGE_ME_VALKEY@127.0.0.1:56379/0
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=3000
INTEGRATION_HOST=127.0.0.1
INTEGRATION_PORT=3001
NODE_ENV=development
